# Neon connection string from the Neon dashboard.
# Use the pooled connection string for the Next.js app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend API key. The recipient address is stored in Neon, not here.
RESEND_API_KEY=re_xxxxxxxx

# Telegram bot from @BotFather, and the chat that should receive the daily message.
TELEGRAM_BOT_TOKEN=123456:telegram-bot-token
TELEGRAM_CHAT_ID=123456789

# Protects POST /api/send-motivation. GitHub Actions sends this as a bearer token.
CRON_SECRET=replace-with-a-long-random-string
